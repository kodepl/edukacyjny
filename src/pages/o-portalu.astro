---
import Campus from "../layouts/Campus.astro";
import site from "../site.config";
---
<Campus title="O portalu" description={`Misja ${site.name}.`} image={site.aboutImage}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <img src={site.aboutImage} alt="" class="aspect-[16/9] w-full rounded-3xl object-cover shadow-card" />
    <h1 class="mt-8 font-display text-4xl font-bold">O portalu</h1>
    <p class="mt-6 text-lg leading-relaxed">{site.name} zbiera praktyczne lekcje i metody nauki. Cel: żeby uczeń, rodzic albo nauczyciel dostał konkret — ćwiczenie, schemat, listę kroków — a nie motywacyjny bełkot.</p>
    <p class="mt-4 leading-relaxed text-slateink/80">Redakcja działa z Lublina ({site.address}). Nie sprzedajemy kursów „zostań geniuszem w weekend”.</p>
    <div class="mt-10 flex gap-4 rounded-3xl bg-white p-5 ring-1 ring-campus/10">
      <img src={site.authorAvatar} alt={site.author} class="h-16 w-16 rounded-2xl object-cover" />
      <div>
        <p class="font-display text-xl font-bold">{site.author}</p>
        <p class="text-sm text-slateink/70">{site.authorBio}</p>
      </div>
    </div>
  </main>
</Campus>
