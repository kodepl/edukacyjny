---
import Campus from "../layouts/Campus.astro";
import { getCollection } from "astro:content";
import site, { coverFor, subjectSlug } from "../site.config";
const posts = (await getCollection("lekcje")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = posts[0];
const track = posts.slice(1, 4);
const rest = posts.slice(4);
---
<Campus title={site.name} description={site.tagline} image={site.heroImage}>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(15,118,110,0.18),_transparent_45%),radial-gradient(circle_at_bottom_left,_rgba(251,191,36,0.18),_transparent_40%)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-14 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="inline-flex rounded-full bg-highlight/30 px-3 py-1 text-xs font-bold uppercase tracking-wider text-slateink">Lekcje · metody · kompetencje</p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-tight md:text-5xl">{site.name}</h1>
        <p class="mt-4 max-w-xl text-lg text-slateink/80">{site.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/lekcje/" class="rounded-full bg-campus px-5 py-2.5 text-sm font-bold text-white shadow-card">Przeglądaj lekcje</a>
          <a href="/przedmioty/" class="rounded-full border border-campus/30 bg-white px-5 py-2.5 text-sm font-bold text-campus">Wybierz przedmiot</a>
        </div>
      </div>
      {featured && (
        <a href={`/lekcje/${featured.slug}/`} class="group overflow-hidden rounded-3xl bg-white shadow-card ring-1 ring-campus/10">
          <img src={coverFor(featured.data.category, featured.data.image)} alt="" class="aspect-[16/10] w-full object-cover transition group-hover:scale-[1.02]" />
          <div class="p-5">
            <div class="flex flex-wrap gap-2 text-[11px] font-bold uppercase tracking-wider text-campus">
              <span>{featured.data.category}</span>
              {featured.data.level && <span class="text-slateink/50">· {featured.data.level}</span>}
            </div>
            <h2 class="mt-2 font-display text-2xl font-bold leading-snug group-hover:text-campus">{featured.data.title}</h2>
            <p class="mt-2 text-sm text-slateink/70">{featured.data.description}</p>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-6">
    <div class="flex flex-wrap gap-2">
      {site.subjects.map((s) => (
        <a href={`/przedmioty/${subjectSlug(s.name)}/`} class="rounded-full border border-campus/20 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-wide text-campus hover:bg-campus hover:text-white">{s.name}</a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8">
    <h2 class="font-display text-2xl font-bold">Ścieżki na start</h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {track.map((post) => (
        <a href={`/lekcje/${post.slug}/`} class="rounded-3xl border border-campus/10 bg-white p-4 shadow-sm hover:shadow-card">
          <img src={coverFor(post.data.category, post.data.image)} alt="" class="aspect-[16/10] w-full rounded-2xl object-cover" />
          <p class="mt-3 text-[11px] font-bold uppercase tracking-wider text-campus">{post.data.category}{post.data.duration ? ` · ${post.data.duration}` : ""}</p>
          <h3 class="mt-1 font-display text-xl font-bold leading-snug">{post.data.title}</h3>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="font-display text-2xl font-bold">Katalog lekcji</h2>
    <div class="mt-6 divide-y divide-campus/10 overflow-hidden rounded-3xl border border-campus/10 bg-white">
      {rest.map((post) => (
        <a href={`/lekcje/${post.slug}/`} class="flex flex-col gap-3 p-4 hover:bg-chalk/80 sm:flex-row sm:items-center">
          <img src={coverFor(post.data.category, post.data.image)} alt="" class="h-20 w-full rounded-xl object-cover sm:w-32" />
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-bold uppercase tracking-wider text-campus">{post.data.category}</p>
            <h3 class="font-display text-lg font-bold">{post.data.title}</h3>
            <p class="truncate text-sm text-slateink/65">{post.data.description}</p>
          </div>
          {post.data.level && <span class="rounded-full bg-chalk px-3 py-1 text-xs font-bold text-campus">{post.data.level}</span>}
        </a>
      ))}
    </div>
  </section>
</Campus>
