---
import Campus from "../../layouts/Campus.astro";
import site, { coverFor } from "../../site.config";
import { getCollection } from "astro:content";
import GithubSlugger from "github-slugger";
export async function getStaticPaths() {
  const posts = await getCollection("lekcje");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const slugger = new GithubSlugger();
const headings = (post.body.match(/^##\s+(.+)$/gm) || []).map((line) => {
  const text = line.replace(/^##\s+/, "");
  return { text, id: slugger.slug(text) };
});
const minutes = Math.max(1, Math.round(post.body.split(/\s+/).filter(Boolean).length / 200));
const author = post.data.author ?? site.author;
const bio = post.data.authorBio ?? site.authorBio;
const cover = coverFor(post.data.category, post.data.image);
const related = (await getCollection("lekcje")).filter((p) => p.slug !== post.slug && p.data.category === post.data.category).slice(0, 3);
---
<Campus title={post.data.title} description={post.data.description} image={cover}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <div class="flex flex-wrap gap-2 text-xs font-bold uppercase tracking-wider text-campus">
      <span class="rounded-full bg-campus/10 px-3 py-1">{post.data.category}</span>
      {post.data.level && <span class="rounded-full bg-highlight/40 px-3 py-1 text-slateink">{post.data.level}</span>}
      {post.data.duration && <span class="rounded-full bg-white px-3 py-1 ring-1 ring-campus/15">{post.data.duration}</span>}
    </div>
    <h1 class="mt-4 font-display text-4xl font-bold leading-tight">{post.data.title}</h1>
    <p class="mt-3 text-sm text-slateink/60">{author} · {minutes} min · {post.data.pubDate.toLocaleDateString("pl-PL")}</p>
    <img src={cover} alt="" class="mt-8 aspect-[16/9] w-full rounded-3xl object-cover shadow-card" />
    {headings.length > 0 && (
      <nav class="mt-8 rounded-2xl border border-campus/15 bg-white p-4 text-sm">
        <p class="font-bold text-campus">Plan lekcji</p>
        <ol class="mt-2 list-decimal space-y-1 pl-5">
          {headings.map((h) => <li><a href={`#${h.id}`} class="hover:text-campus">{h.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose prose-lg prose-teal mt-10 max-w-none prose-headings:font-display prose-a:text-campus">
      <Content />
    </div>
    <section class="mt-12 flex gap-4 rounded-3xl bg-white p-5 ring-1 ring-campus/10">
      <img src={site.authorAvatar} alt={author} class="h-16 w-16 rounded-2xl object-cover" />
      <div>
        <p class="font-display text-xl font-bold">{author}</p>
        <p class="text-sm text-slateink/70">{bio}</p>
      </div>
    </section>
    {related.length > 0 && (
      <div class="mt-10">
        <p class="text-xs font-bold uppercase tracking-wider text-campus">Kolejne lekcje z przedmiotu</p>
        <ul class="mt-3 space-y-2">
          {related.map((item) => (
            <li><a href={`/lekcje/${item.slug}/`} class="font-display text-lg font-bold text-campus hover:underline">{item.data.title}</a></li>
          ))}
        </ul>
      </div>
    )}
  </article>
</Campus>
