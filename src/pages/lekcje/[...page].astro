---
import Campus from "../../layouts/Campus.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection("lekcje")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---
<Campus title="Lekcje" description="Katalog materiałów edukacyjnych.">
  <main class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-display text-4xl font-bold">Lekcje</h1>
    <p class="mt-2 text-slateink/70">Wybierz temat i ucz się we własnym tempie.</p>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => (
        <a href={`/lekcje/${post.slug}/`} class="rounded-3xl bg-white p-4 shadow-card ring-1 ring-campus/10">
          <img src={coverFor(post.data.category, post.data.image)} alt="" class="aspect-[16/10] w-full rounded-2xl object-cover" />
          <p class="mt-3 text-[11px] font-bold uppercase tracking-wider text-campus">{post.data.category}</p>
          <h2 class="mt-1 font-display text-xl font-bold leading-snug">{post.data.title}</h2>
        </a>
      ))}
    </div>
  </main>

  {page.lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-3 text-sm" aria-label="Paginacja">
      {page.url.prev ? (
        <a href={page.url.prev} class="underline-offset-2 hover:underline">← Nowsze</a>
      ) : (
        <span class="opacity-40">← Nowsze</span>
      )}
      <span class="tabular-nums opacity-70">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="underline-offset-2 hover:underline">Starsze →</a>
      ) : (
        <span class="opacity-40">Starsze →</span>
      )}
    </nav>
  )}

</Campus>
