---
import site, { subjectSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0 && location.hostname.endsWith("edukacyjny.info")){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Literata:opsz,wght@7..72,500;7..72,700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-chalk font-ui text-slateink">
    <div class="border-b border-campus/20 bg-white/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="flex items-center gap-3">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-campus text-sm font-bold text-white">Ed</span>
          <span>
            <span class="block font-display text-xl font-bold text-slateink">{site.name}</span>
            <span class="block text-xs text-campus">portal lekcji</span>
          </span>
        </a>
        <nav class="hidden flex-wrap items-center gap-5 text-sm font-semibold md:flex">
          <a href="/" class="hover:text-campus">Start</a>
          <a href="/lekcje/" class="hover:text-campus">Lekcje</a>
          <a href="/przedmioty/" class="hover:text-campus">Przedmioty</a>
          <a href="/o-portalu/" class="hover:text-campus">O portalu</a>
          <a href="/kontakt/" class="rounded-full bg-campus px-4 py-1.5 text-white hover:bg-slateink">Kontakt</a>
        </nav>
      </div>
    </div>
    <slot />
    <footer class="mt-20 border-t border-campus/15 bg-white">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <p class="font-display text-2xl font-bold">{site.name}</p>
          <p class="mt-2 text-sm text-slateink/70">{site.address}</p>
          <p class="mt-1 text-sm"><a class="text-campus underline" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-campus">Przedmioty</p>
          <ul class="mt-3 space-y-1 text-sm">
            {site.subjects.map((s) => (
              <li><a href={`/przedmioty/${subjectSlug(s.name)}/`} class="hover:text-campus">{s.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-sm text-slateink/70">
          <p>Materiały edukacyjne do nauki w domu i w klasie. Bez reklam kursów „zostań mistrzem w 7 dni”.</p>
          <p class="mt-4"><a href="/polityka-prywatnosci/" class="underline">Prywatność</a> · <a href="/regulamin/" class="underline">Regulamin</a></p>
          <p class="mt-2">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </div>
    </footer>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token":"4ae5567cc5b24f829c45684d912f0823"}'></script>
  </body>
</html>
